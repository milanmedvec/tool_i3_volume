#!/usr/bin/env bash
set -euo pipefail

refresh_i3status() {
    if [[ -n "${I3STATUS_ADDITIONAL_CMD:-}" ]]; then
        bash -c "$I3STATUS_ADDITIONAL_CMD" || true
    elif command -v i3status_additional.sh >/dev/null 2>&1; then
        i3status_additional.sh || true
    fi

    killall -SIGUSR1 i3status 2>/dev/null || true
}

print_volume() {
    echo -ne "\r\033[2KVolume: $(pamixer --get-volume-human)"
}

increase_volume() {
    pactl set-sink-volume @DEFAULT_SINK@ +2%
    refresh_i3status
    print_volume
}

decrease_volume() {
    pactl set-sink-volume @DEFAULT_SINK@ -2%
    refresh_i3status
    print_volume
}

trap $'echo -e \'\nExiting...\'; exit 0' SIGINT

echo "Volume control: [+] up  [-] down  [Ctrl+C] quit"
print_volume

while true; do
    read -r -n 1 -s key

    case "$key" in
        '+') increase_volume ;;
        '-') decrease_volume ;;
    esac
done
