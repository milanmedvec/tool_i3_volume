#!/usr/bin/env bash
set -euo pipefail

need() {
    command -v "$1" >/dev/null 2>&1 || {
        printf '%s: missing required command: %s\n' "${0##*/}" "$1" >&2
        exit 127
    }
}

need pactl


refresh_i3status() {
    if [[ -n "${I3STATUS_ADDITIONAL_CMD:-}" ]]; then
        bash -c "$I3STATUS_ADDITIONAL_CMD" || true
    elif command -v i3status-additional >/dev/null 2>&1; then
        i3status-additional || true
    fi

    killall -SIGUSR1 i3status 2>/dev/null || true
}

pactl set-sink-mute @DEFAULT_SINK@ toggle
refresh_i3status
